# Online storage. Copy to backend/config/storage.env and fill in.
#
# Cloudflare R2 (10 GB free, free egress) is the recommended zero-cost option:
#   1. Cloudflare dashboard -> R2 -> Create bucket
#   2. R2 -> Manage R2 API Tokens -> Create token (Object Read & Write)
#   3. Copy the Access Key ID, Secret Access Key and your account ID below.
#
# Runpod network volumes also work but are billed per GB-month.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<BUCKET_NAME>
S3_ACCESS_KEY=217cb66067dd0e3634e1a5ac0c683dfa
S3_SECRET_KEY=0d1aa43fe90fc3cc4fbf9d93c1f6dd858588dda328fa09b078da90154f90e662
