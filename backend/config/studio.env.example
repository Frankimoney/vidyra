# AI Studio / RunPod configuration for the local PC launcher.
# Copy this file to studio.env (same folder) and fill in values.
# The launcher (Start Vidyra PC.bat) reads studio.env on startup.
#
# --- Option A: test the UI with NO GPU cost (placeholder media) ---
# RUNPOD_FAKE=1
#
# --- Option B: real RunPod Serverless GPU ---
# RUNPOD_API_KEY=your_runpod_api_key
# RUNPOD_ENDPOINT_ID=your_endpoint_id
# RUNPOD_API_BASE=https://api.runpod.ai/v2
#
# Real mode needs the PC backend to be reachable from the internet so the GPU
# worker can download inputs and post results back. Set PUBLIC_URL to your
# tunnel/VPS address (e.g. an ngrok/cloudflared URL or your VPS domain).
# PUBLIC_URL=http://192.168.43.176:8000
#
# Optional tuning:
# RUNPOD_POLL_SECONDS=6
# RUNPOD_TIMEOUT_MINUTES=40
# STUDIO_MAX_RUNS_PER_DAY=20
# STUDIO_MAX_PROMPT_CHARS=2000
