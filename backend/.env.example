# --- Firebase (free Spark plan: Auth + Firestore only) ---
# NOTE: Firebase Cloud Storage requires the paid Blaze plan since Feb 3, 2026,
# so Vidyra does NOT use it. Media + finished videos are stored in Cloudflare
# R2 (see the R2 block below) and served via presigned URLs.
FIREBASE_PROJECT_ID=your-project-id
# Path to a Firebase service-account JSON (or set GOOGLE_APPLICATION_CREDENTIALS)
SERVICE_ACCOUNT_PATH=config/vidyra-firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=
# Render/RunPod secrets can carry the full JSON instead of a file path.
FIREBASE_CREDENTIALS_JSON=

# --- App / security ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# External base URL of the API, used to build absolute media URLs.
PUBLIC_URL=http://localhost:8000
# Secret used to HMAC-sign media URLs. REQUIRED in production.
SIGNED_URL_SECRET=change-me-to-a-long-random-string
# When APP_ENV=development and DEV_API_KEY is set, the API accepts
# "Authorization: Bearer <DEV_API_KEY>" so you can test without Firebase.
DEV_API_KEY=vidyra-dev-key
API_RATE_LIMIT_PER_MIN=60
# Render sleeps, so production uses `python -m app.cron` for cleanup/series.
BACKGROUND_LOOPS=true

# --- Storage / jobs (Cloudflare R2 only) ---
STORAGE_BACKEND=r2
# Set R2_ACCOUNT_ID and the bucket/keys from the Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional custom domain / r2.dev URL for permanent public share links.
R2_PUBLIC_BASE_URL=
SIGNED_URL_TTL_SECONDS=3600
SHARE_URL_TTL_SECONDS=604800
# Local scratch only; never used to persist media.
STORAGE_ROOT=storage/cache
WORK_ROOT=storage/work
OUTPUT_PUBLIC_DIR=storage/public
MAX_MEDIA_COUNT=10
MAX_MEDIA_BYTES=52428800
MAX_SCRIPT_CHARS=6000
MAX_CONCURRENCY=1

# --- Vidyra engine ---
VIDYRA_VOICE_DIR=models/piper
VIDYRA_MUSIC_DIR=config/music
VIDYRA_WHISPER_MODEL=base

# --- RunPod ---
# AI Studio (ComfyUI/diffusion) endpoint.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Render pipeline (Piper/Whisper/FFmpeg) endpoint. When set, the API submits
# jobs here instead of rendering in-process; the worker writes Firestore
# directly. Leave empty in development to render locally.
RUNPOD_PIPELINE_ENDPOINT_ID=
RUNPOD_API_BASE=https://api.runpod.ai/v2
RUNPOD_FAKE=0
RUNPOD_POLL_SECONDS=6
RUNPOD_TIMEOUT_MINUTES=40

# --- LLM / Gemini (scriptwriting) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=