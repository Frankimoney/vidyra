# --- Firebase (free Spark plan: Auth + Firestore only) ---
# NOTE: Firebase Cloud Storage requires the paid Blaze plan since Feb 3, 2026,
# so Vidyra does NOT use it. Media + finished videos are stored on the server
# disk ("local" STORAGE_BACKEND below) and served via signed URLs.
FIREBASE_PROJECT_ID=your-project-id
# Path to a Firebase service-account JSON (or set GOOGLE_APPLICATION_CREDENTIALS)
SERVICE_ACCOUNT_PATH=config/vidyra-firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=

# --- App / security ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# External base URL of the API, used to build absolute media URLs.
PUBLIC_URL=http://localhost:8000
# Secret used to HMAC-sign media URLs. REQUIRED in production.
SIGNED_URL_SECRET=change-me-to-a-long-random-string
# When APP_ENV=development and DEV_API_KEY is set, the API accepts
# "Authorization: Bearer <DEV_API_KEY>" so you can test without Firebase.
DEV_API_KEY=vidyra-dev-key
API_RATE_LIMIT_PER_MIN=60

# --- Storage / jobs ---
# local (default, free, server disk - use with Oracle Always Free block storage)
# firebase (only if you upgrade to the Blaze plan)
STORAGE_BACKEND=local
STORAGE_ROOT=storage/data
WORK_ROOT=storage/work
OUTPUT_PUBLIC_DIR=storage/public
MAX_MEDIA_COUNT=10
MAX_MEDIA_BYTES=52428800
MAX_SCRIPT_CHARS=6000
MAX_CONCURRENCY=1

# --- Vidyra engine ---
VIDYRA_VOICE_DIR=models/piper
VIDYRA_MUSIC_DIR=config/music
VIDYRA_WHISPER_MODEL=base