rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Client profile mirror. The API is the writer; clients may read their own.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Jobs are created, updated and published by the FastAPI backend using the
    // Admin SDK. Clients only subscribe to their own job documents.
    match /videos/{jobId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Studio runs are also backend-owned; the Studio tab subscribes for
    // progress, so owners get read-only access.
    match /studio_runs/{runId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Everything else (projects, characters, workspaces, usage, series) is
    // intentionally default-denied: the API enforces ownership and identity.
  }
}
