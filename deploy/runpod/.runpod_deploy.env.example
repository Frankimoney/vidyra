# Copy this file to .runpod_deploy.env and fill in the values.
# .runpod_deploy.env is ignored by git and should never be committed.

# Required: RunPod API key from https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# Required: network volume ID. Run the script with --list-volumes to see IDs,
# or create one with:
#   python deploy/runpod/deploy_serverless.py --create-volume \
#     --volume-size-gb 100 --data-center US-KS-2
RUNPOD_NETWORK_VOLUME_ID=

# Required for --create-volume; otherwise defaults to the volume's data center.
# The volume and the Studio endpoint must be in the same data center.
RUNPOD_DATA_CENTER_ID=

# Required for the pipeline worker: same value as the Render service.
SIGNED_URL_SECRET=

# Optional but recommended for film scriptwriting.
GEMINI_API_KEY=

# Optional overrides.
PUBLIC_URL=https://vidyra-api.onrender.com
RUNPOD_STUDIO_GPU_TYPE=NVIDIA L40S
RUNPOD_PIPELINE_CPU_FLAVOR=cpu5c
RUNPOD_PIPELINE_VCPU=8
